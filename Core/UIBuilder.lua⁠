-- File: Core/UIBuilder.lua
local UIBuilder = {}

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local AutoFarm_Games = {
    [111894976456494] = true, -- Anime Life
}

local ESP_Games = {
    [94309190278698] = true,  -- Safety Not Required
    [77419850589072] = true,
}

local function isGameInList(list)
    return list[game.PlaceId] == true
end

function UIBuilder.Build(Window)
    -- tab farm
    if isGameInList(AutoFarm_Games) then
        local FarmTab = Window:Tab({ Title = "Farm", Icon = "sparkles" })
        local FarmSec = FarmTab:Section({ Title = "Auto Farm Options", Opened = true })

        FarmSec:Toggle({
            Title = "Auto Farm",
            Value = false,
            Callback = function(v)
                print("Auto Farm State:", v)
            end
        })
    end

 
    if isGameInList(ESP_Games) then
        local CombatTab = Window:Tab({ Title = "Combat & Visuals", Icon = "sword" })
        local CombatSec = CombatTab:Section({ Title = "ESP Options", Opened = true })

        CombatSec:Toggle({
            Title = "Player ESP",
            Value = false,
            Callback = function(v)
                print("ESP State:", v)
            end
        })
    end


    local MiscTab = Window:Tab({ Title = "Misc", Icon = "wrench" })

    -- Section Local Player
    local PlayerSec = MiscTab:Section({ Title = "Local Player", Opened = true })
    PlayerSec:Slider({
        Title = "Walk Speed",
        Value = { Default = 16, Min = 16, Max = 300 },
        Callback = function(v)
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
                LocalPlayer.Character.Humanoid.WalkSpeed = v
            end
        end
    })

    PlayerSec:Slider({
        Title = "Jump Power",
        Value = { Default = 50, Min = 50, Max = 400 },
        Callback = function(v)
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
                LocalPlayer.Character.Humanoid.UseJumpPower = true
                LocalPlayer.Character.Humanoid.JumpPower = v
            end
        end
    })

    -- Section Server
    local ServerSec = MiscTab:Section({ Title = "Server & Utilities", Opened = false })
    ServerSec:Button({
        Title = "Rejoin Server",
        Callback = function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end
    })

    ServerSec:Button({
        Title = "Copy JobId",
        Callback = function()
            if setclipboard then
                setclipboard(game.JobId)
                Window:Notify({ Title = "Misc", Content = "Đã copy JobId!", Duration = 2 })
            end
        end
    })

    --  dis.gg tab
    local DiscordTab = Window:Tab({ Title = "Discord", Icon = "message-circle" })
    local DiscordSec = DiscordTab:Section({ Title = "Community", Opened = true })
    DiscordSec:Button({
        Title = "Copy Discord Invite",
        Callback = function()
            if setclipboard then setclipboard("https://discord.gg/6y7TpYTBkW") end
        end
    })
end

return UIBuilder
